                            task.wait(1)
                        end
                    end
                end
            end)
        end

        -- MATCH HANDLING & AUTO PLAY
        if isMatchActuallyStarted() then
            if is2xSpeedEnabled then
                setGameSpeed(2)
            end

            if isAutoPlayEnabled and not isPlaying and not isRecording and #recordedActions > 0 and not hasAutoPlayedThisSession then
                hasAutoPlayedThisSession = true
                for i = 13, 1, -1 do
                    StatusLabel.Text = string.format("Status: Match Detected!\nWaiting Spawn Buffer: %d s", i)
                    task.wait(1)
                end
                playMacro()
            end
        else
            hasAutoPlayedThisSession = false
            hasVotedThisSession = false
        end
    end
end)
