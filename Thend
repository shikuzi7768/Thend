local function saveMacro(fileName)
    if not supportsFileSystem or #recordedActions == 0 then return end
    local serializedData = {}
    for _, action in ipairs(recordedActions) do
        local copyAction = {
            actionType = action.actionType,
            time = action.time,
            towerIndex = action.towerIndex,
            towerName = action.towerName,
            arg3 = action.arg3,
            arg4 = action.arg4,
            arg5 = action.arg5
        }
        if action.cframe then copyAction.cframe = {action.cframe:GetComponents()} end
        table.insert(serializedData, copyAction)
    end
    writefile(FOLDER_NAME .. "/" .. fileName .. ".json", HttpService:JSONEncode(serializedData))
    selectedMacroFile = fileName
    SelectLabel.Text = "Selected: " .. fileName
    StatusLabel.Text = "Status: Macro Berhasil Disimpan!"
    saveConfigToFile()
end

local function loadMacro(fileName)
    if not supportsFileSystem then return end
    local path = FOLDER_NAME .. "/" .. fileName .. ".json"
    if not isfile(path) then return end
    local decoded = HttpService:JSONDecode(readfile(path))
    recordedActions = {}
    for _, action in ipairs(decoded) do
        local restored = {
            actionType = action.actionType,
            time = action.time,
            towerIndex = action.towerIndex,
            towerName = action.towerName,
            arg3 = action.arg3,
            arg4 = action.arg4,
            arg5 = action.arg5
        }
        if action.cframe then restored.cframe = CFrame.new(unpack(action.cframe)) end
        table.insert(recordedActions, restored)
    end
    selectedMacroFile = fileName
    SelectLabel.Text = "Selected: " .. fileName
    StatusLabel.Text = string.format("Status: Loaded %s (%d aksi)", fileName, #recordedActions)
    saveConfigToFile()
end

SaveBtn.MouseButton1Click:Connect(function()
    if SaveNameBox.Text ~= "" then saveMacro(SaveNameBox.Text) end
end)

RefreshBtn.MouseButton1Click:Connect(function()
    if not supportsFileSystem then return end
    local files = listfiles(FOLDER_NAME)
    local fileList = {}
    for _, path in ipairs(files) do
        local name = path:match("([^/\\]+)%.json$")
        if name and name ~= "config" then
            table.insert(fileList, name)
        end
    end
    
    if #fileList > 0 then
        local currentIndex = table.find(fileList, selectedMacroFile) or 0
        local nextIndex = (currentIndex % #fileList) + 1
        loadMacro(fileList[nextIndex])
    else
        StatusLabel.Text = "Status: Tidak ada file macro disimpan."
    end
end)

-- LOGIKA HAPUS FILE MACRO
DeleteBtn.MouseButton1Click:Connect(function()
    if not supportsFileSystem then
        StatusLabel.Text = "Status: Executor tidak mendukung FileSystem!"
        return
    end

    if selectedMacroFile == "" then
        StatusLabel.Text = "Status: Pilih file macro dulu menggunakan Switch File!"
        return
    end

    local path = FOLDER_NAME .. "/" .. selectedMacroFile .. ".json"
    if isfile(path) then
        local deletedName = selectedMacroFile
        delfile(path)
        
        selectedMacroFile = ""
        recordedActions = {}
        SelectLabel.Text = "Selected: None"
        StatusLabel.Text = string.format("Status: File '%s.json' telah dihapus!", deletedName)
        saveConfigToFile()
    else
        StatusLabel.Text = "Status: File tidak ditemukan!"
    end
end)
