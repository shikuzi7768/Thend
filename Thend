local function getSlopRemote(name)
    local searchFolders = {
        ReplicatedStorage:FindFirstChild("Functions"),
        ReplicatedStorage:FindFirstChild("Remotes"),
        ReplicatedStorage:FindFirstChild("Events"),
        ReplicatedStorage
    }
    for _, folder in ipairs(searchFolders) do
        if folder then
            local rem = folder:FindFirstChild(name)
            if rem then return rem end
        end
    end
    return nil
end

local function findTowerByPosition(targetCFrame, maxDist)
    if not targetCFrame then return nil end
    local towersFolder = Workspace:FindFirstChild("Towers") or Workspace:FindFirstChild("PlacedTowers") or Workspace
    maxDist = maxDist or 8

    local closestTower = nil
    local shortestDistance = maxDist

    for _, tower in ipairs(towersFolder:GetChildren()) do
        if tower:IsA("Model") then
            local primaryPart = tower.PrimaryPart or tower:FindFirstChild("HumanoidRootPart") or tower:FindFirstChildWhichIsA("BasePart")
            if primaryPart then
                local dist = (primaryPart.Position - targetCFrame.Position).Magnitude
                if dist < shortestDistance then
                    shortestDistance = dist
                    closestTower = tower
                end
            end
        end
    end
    return closestTower
end

local function getTowerLevel(tower)
    if not tower or not tower:IsDescendantOf(Workspace) then return -1 end
    if tower:GetAttribute("Level") then return tower:GetAttribute("Level") end
    
    local levelObj = tower:FindFirstChild("Level") or tower:FindFirstChild("UpgradeLevel") or tower:FindFirstChild("Upgrade")
    if levelObj then
        if levelObj:IsA("ValueBase") then return levelObj.Value end
        if levelObj:IsA("ModuleScript") or levelObj:IsA("Folder") then return #levelObj:GetChildren() end
    end
    return 0
end

