-- ==========================================
-- SAFE HOOKING (NON-BLOCKING)
-- ==========================================
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local args = {...}

    local result = oldNamecall(self, ...)

    if isRecording and not checkcaller() and (method == "InvokeServer" or method == "FireServer") then
        local nameLower = string.lower(self.Name)
        
        task.spawn(function()
            local currentTime = tick() - recordStartTime

            if string.find(nameLower, "spawn") or string.find(nameLower, "place") then
                local spawnedTower = nil
                if typeof(result) == "Instance" then spawnedTower = result end
                if typeof(result) == "table" and result[1] then spawnedTower = result[1] end
                
                if not spawnedTower and args[2] then
                    task.wait(0.2)
                    spawnedTower = findTowerByPosition(args[2])
                end

                table.insert(placedTowersRecord, spawnedTower)
                local towerIndex = #placedTowersRecord

                if #recordedActions == 0 then recordStartTime = tick(); currentTime = 0 end

                table.insert(recordedActions, {
                    actionType = "Place",
                    time = currentTime,
                    towerIndex = towerIndex,
                    towerName = args[1],
                    cframe = args[2],
                    arg3 = args[3],
                    arg4 = args[4],
                    arg5 = args[5]
                })
                logConsole(string.format("Recorded Place #%d: %s", towerIndex, tostring(args[1])))
                StatusLabel.Text = string.format("Status: Recording...\nRecorded Place #%d", towerIndex)

            elseif string.find(nameLower, "upgrade") then
                local targetTower = args[1]
                local towerIndex = nil

                if targetTower then
                    for idx, inst in pairs(placedTowersRecord) do
                        if inst == targetTower then towerIndex = idx; break end
                    end
                end

                if not towerIndex and #placedTowersRecord > 0 then
                    towerIndex = #placedTowersRecord
                end

                if towerIndex then
                    table.insert(recordedActions, {
                        actionType = "Upgrade",
                        time = currentTime,
                        towerIndex = towerIndex
                    })
                    logConsole(string.format("Recorded Upgrade #%d", towerIndex))
                    StatusLabel.Text = string.format("Status: Recording...\nRecorded Upgrade #%d", towerIndex)
                end
            end
        end)
    end

    return result
end))

-- ==========================================
-- PLAYBACK ENGINE
-- ==========================================
local function playMacro()
    if isPlaying or #recordedActions == 0 then return end

    local spawnRemote = getSlopRemote("SpawnTower") or getSlopRemote("PlaceTower") or getSlopRemote("Spawn")
    local upgradeRemote = getSlopRemote("UpgradeTower") or getSlopRemote("Upgrade")

    if not spawnRemote or not upgradeRemote then
        StatusLabel.Text = "Status: Remote Error!\nRemote game tidak ditemukan."
        return
    end

    isPlaying = true
    placedTowersPlay = {}
    local playStartTime = tick()

    task.spawn(function()
        for index, action in ipairs(recordedActions) do
            if not isPlaying then break end

            local targetTime = action.time
            local timeToWait = targetTime - (tick() - playStartTime)

            while timeToWait > 0 and isPlaying do
                timeToWait = targetTime - (tick() - playStartTime)
                StatusLabel.Text = string.format("Status: Playing...\n[%d/%d] Next: %s (%.1fs)", index, #recordedActions, action.actionType, math.max(timeToWait, 0))
                task.wait(math.min(timeToWait, 0.05))
            end

            if not isPlaying then break end

            if action.actionType == "Place" then
                local newTower = nil
                for attempt = 1, 30 do
                    if not isPlaying then break end
                    
                    pcall(function()
                        if spawnRemote:IsA("RemoteFunction") then
                            newTower = spawnRemote:InvokeServer(action.towerName, action.cframe, action.arg3, action.arg4, action.arg5)
                        else
                            spawnRemote:FireServer(action.towerName, action.cframe, action.arg3, action.arg4, action.arg5)
                        end
                    end)

                    if not newTower and action.cframe then
                        task.wait(0.1)
                        newTower = findTowerByPosition(action.cframe)
                    end

                    if newTower then
                        placedTowersPlay[action.towerIndex] = newTower
                        logConsole(string.format("Placed Tower #%d", action.towerIndex))
                        break
                    else
                        StatusLabel.Text = string.format("Status: Waiting Cash...\nPlace #%d (Retry %d/30)", action.towerIndex, attempt)
                        task.wait(0.3)
                    end
                end

            elseif action.actionType == "Upgrade" then
                local targetTower = placedTowersPlay[action.towerIndex]

                if not targetTower or not targetTower:IsDescendantOf(Workspace) then
                    for _, act in ipairs(recordedActions) do
                        if act.actionType == "Place" and act.towerIndex == action.towerIndex and act.cframe then
                            targetTower = findTowerByPosition(act.cframe)
                            placedTowersPlay[action.towerIndex] = targetTower
                            break
                        end
                    end
                end

                if targetTower then
                    pcall(function()
                        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                            local primaryPart = targetTower.PrimaryPart or targetTower:FindFirstChildWhichIsA("BasePart")
                            if primaryPart then
                                LocalPlayer.Character.HumanoidRootPart.CFrame = primaryPart.CFrame + Vector3.new(0, 3, 0)
                            end
                        end
                    end)

                    local initialLevel = getTowerLevel(targetTower)
                    local upgradedSuccess = false

                    for attempt = 1, 30 do
                        if not isPlaying then break end

                        pcall(function()
                            if upgradeRemote:IsA("RemoteFunction") then
                                upgradeRemote:InvokeServer(targetTower)
                            else
                                upgradeRemote:FireServer(targetTower)
                            end
                        end)

                        task.wait(0.2)
                        local currentLevel = getTowerLevel(targetTower)

                        if currentLevel > initialLevel then
                            upgradedSuccess = true
                            logConsole(string.format("Upgraded Tower #%d ke Level %d", action.towerIndex, currentLevel))
                            break
                        end

                        StatusLabel.Text = string.format("Status: Waiting Cash for Upgrade...\nUpgrade #%d (Retry %d/30)", action.towerIndex, attempt)
                        task.wait(0.2)
                    end
                end
            end
        end

        StatusLabel.Text = "Status: Playback Selesai!"
        isPlaying = false
    end)
end

